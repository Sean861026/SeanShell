<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SeanShell.App.ActivityIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SeanShell Activity Island">
    <Border
        x:Name="IslandRoot"
        Padding="18,10"
        AutomationProperties.Name="Activity Island"
        BorderThickness="1"
        CornerRadius="38"
        PointerPressed="OnPointerPressed">
        <Grid x:Name="IslandContent" ColumnSpacing="12">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="EntranceTranslate" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="IdentityTile"
                Width="44"
                Height="44"
                CornerRadius="22"
                VerticalAlignment="Center">
                <FontIcon x:Name="ActivityGlyph" FontSize="20" Glyph="&#xE8A7;" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="ActivityLabel" CharacterSpacing="140" FontSize="10" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ActivityTitle" FontSize="16" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ActivityDetail" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
