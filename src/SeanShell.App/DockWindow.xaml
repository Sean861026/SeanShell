<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SeanShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SeanShell Dock"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="DockRoot"
        AutomationProperties.HelpText="Press Escape to return to the previous window."
        Background="Transparent"
        GotFocus="OnDockGotFocus"
        KeyDown="OnDockKeyDown"
        LostFocus="OnDockLostFocus"
        PointerEntered="OnDockPointerEntered"
        PointerExited="OnDockPointerExited">
        <Border
            x:Name="ExpandedDock"
            Padding="7,7,7,7"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20">
            <Grid ColumnSpacing="{StaticResource SeanSpace8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.ColumnSpan="5"
                    Width="112"
                    Height="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    CornerRadius="1"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.3" Color="{ThemeResource SystemAccentColorLight1}" />
                            <GradientStop Offset="0.7" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Button
                    x:Name="LauncherButton"
                    AutomationProperties.Name="Open SeanShell Launcher"
                    Click="OnLauncherClicked"
                    PointerEntered="OnDockItemPointerEntered"
                    PointerExited="OnDockItemPointerExited"
                    PointerPressed="OnDockItemPointerPressed"
                    PointerReleased="OnDockItemPointerReleased"
                    Style="{StaticResource SeanDockLauncherButtonStyle}"
                    ToolTipService.ToolTip="Open Launcher">
                    <Image
                        Width="{StaticResource SeanDockActionIconSize}"
                        Height="{StaticResource SeanDockActionIconSize}"
                        Source="Assets/Square44x44Logo.targetsize-48_altform-unplated.png"
                        Stretch="Uniform" />
                </Button>

                <Border
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    IsHitTestVisible="False"
                    Style="{StaticResource SeanDockApplicationRegionStyle}" />

                <ListView
                    x:Name="PinnedList"
                    Grid.Column="1"
                    MaxWidth="352"
                    AllowDrop="True"
                    AutomationProperties.Name="Pinned applications"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnPinnedApplicationsDragCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="OnPinnedApplicationClicked"
                    ItemContainerStyle="{StaticResource SeanPinnedDockItemStyle}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Width="40"
                                Height="44"
                                AutomationProperties.HelpText="Middle-click to open a new instance. Drag to reorder, or use Move left and Move right in the context menu."
                                AutomationProperties.Name="{Binding AccessibleName}"
                                ContextRequested="OnPinnedApplicationContextRequested"
                                PointerEntered="OnDockItemPointerEntered"
                                PointerExited="OnDockItemPointerExited"
                                PointerPressed="OnDockItemPointerPressed"
                                PointerReleased="OnDockItemPointerReleased"
                                ToolTipService.ToolTip="{Binding ToolTipText}">
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource SeanCompactCornerRadius}"
                                    VerticalAlignment="Top">
                                    <Grid
                                        Width="{StaticResource SeanDockAppIconSize}"
                                        Height="{StaticResource SeanDockAppIconSize}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="17"
                                            Glyph="{Binding Glyph}"
                                            Visibility="{Binding FallbackIconVisibility}" />
                                        <Image
                                            Width="{StaticResource SeanDockAppIconSize}"
                                            Height="{StaticResource SeanDockAppIconSize}"
                                            Source="{Binding Icon}"
                                            Stretch="Uniform"
                                            Visibility="{Binding IconVisibility}" />
                                    </Grid>
                                </Border>
                                <Border
                                    Width="14"
                                    Height="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="8"
                                        Glyph="&#xE718;" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    x:Name="PinnedSeparator"
                    Grid.Column="2"
                    Width="1"
                    Height="32"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

                <Grid Grid.Column="3">
                    <ListView
                        x:Name="WindowList"
                        AutomationProperties.Name="Open windows on this display"
                        IsItemClickEnabled="True"
                        ItemClick="OnWindowClicked"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <StaticResource ResourceKey="SeanDockItemStyle" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="40"
                                    Height="44"
                                    AutomationProperties.HelpText="Middle-click opens a new instance when a matching installed application is available."
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    ContextRequested="OnWindowContextRequested"
                                    Opacity="{Binding ContentOpacity}"
                                    PointerEntered="OnDockItemPointerEntered"
                                    PointerExited="OnDockItemPointerExited"
                                    PointerPressed="OnDockItemPointerPressed"
                                    PointerReleased="OnDockItemPointerReleased"
                                    ToolTipService.ToolTip="{Binding ToolTipText}">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="Transparent"
                                        CornerRadius="{StaticResource SeanCompactCornerRadius}"
                                        VerticalAlignment="Top">
                                        <Grid>
                                            <Border
                                                Margin="2"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="{StaticResource SeanCompactCornerRadius}"
                                                Visibility="{Binding ActiveIndicatorVisibility}" />
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="{StaticResource SeanDockGlyphIconSize}"
                                                Glyph="&#xE8A7;"
                                                Visibility="{Binding FallbackIconVisibility}" />
                                            <Image
                                                Width="{StaticResource SeanDockAppIconSize}"
                                                Height="{StaticResource SeanDockAppIconSize}"
                                                Source="{Binding Icon}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconVisibility}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Width="14"
                                        Height="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding PinnedIndicatorVisibility}">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="8"
                                            Glyph="&#xE718;" />
                                    </Border>
                                    <Border
                                        MinWidth="17"
                                        Height="17"
                                        Padding="4,0"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding CountBadgeVisibility}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{Binding CountText}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        Width="24"
                                        Height="4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding ActiveIndicatorVisibility}" />
                                    <Border
                                        Width="10"
                                        Height="3"
                                        Background="{ThemeResource TextFillColorSecondaryBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding RunningIndicatorVisibility}" />
                                    <Border
                                        Width="5"
                                        Height="3"
                                        Background="{ThemeResource TextFillColorDisabledBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding MinimizedIndicatorVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SeanSpace8}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                        <TextBlock x:Name="EmptyStateText" Text="Loading open windows…" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Column="4"
                    Style="{StaticResource SeanDockSystemRegionStyle}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource SeanSpace4}">
                        <TextBlock
                            x:Name="DockCountText"
                            Visibility="Collapsed" />
                        <ToggleButton
                            x:Name="ShowDesktopButton"
                            AutomationProperties.HelpText="Minimizes every application window. Select again to restore them."
                            AutomationProperties.Name="Show desktop"
                            Click="OnShowDesktopClicked"
                            IsThreeState="False"
                            PointerEntered="OnDockItemPointerEntered"
                            PointerExited="OnDockItemPointerExited"
                            PointerPressed="OnDockItemPointerPressed"
                            PointerReleased="OnDockItemPointerReleased"
                            Style="{StaticResource SeanDockToggleButtonStyle}"
                            ToolTipService.ToolTip="Show desktop">
                            <Grid
                                Width="{StaticResource SeanDockActionIconSize}"
                                Height="{StaticResource SeanDockActionIconSize}">
                                <PathIcon
                                    x:Name="ShowDesktopIcon"
                                    Width="{StaticResource SeanDockGlyphIconSize}"
                                    Height="{StaticResource SeanDockGlyphIconSize}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="M1,2 L15,2 L15,12 L10,12 L10,14 L13,14 L13,15 L3,15 L3,14 L6,14 L6,12 L1,12 Z M2.5,3.5 L2.5,10.5 L13.5,10.5 L13.5,3.5 Z" />
                                <PathIcon
                                    x:Name="RestoreWindowsIcon"
                                    Width="{StaticResource SeanDockGlyphIconSize}"
                                    Height="{StaticResource SeanDockGlyphIconSize}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="M4,1 L15,1 L15,12 L13,12 L13,3 L4,3 Z M1,4 L12,4 L12,15 L1,15 Z M2.5,5.5 L2.5,13.5 L10.5,13.5 L10.5,5.5 Z"
                                    Visibility="Collapsed" />
                            </Grid>
                        </ToggleButton>
                        <Button
                            x:Name="SystemAreaButton"
                            AutomationProperties.Name="Show Windows system area"
                            Click="OnSystemAreaClicked"
                            PointerEntered="OnDockItemPointerEntered"
                            PointerExited="OnDockItemPointerExited"
                            PointerPressed="OnDockItemPointerPressed"
                            PointerReleased="OnDockItemPointerReleased"
                            Style="{StaticResource SeanDockActionButtonStyle}"
                            ToolTipService.ToolTip="Show the Windows taskbar for notification and system tray access"
                            Visibility="Collapsed">
                            <Grid
                                Width="{StaticResource SeanDockActionIconSize}"
                                Height="{StaticResource SeanDockActionIconSize}">
                                <PathIcon
                                    x:Name="RevealSystemAreaIcon"
                                    Width="{StaticResource SeanDockGlyphIconSize}"
                                    Height="{StaticResource SeanDockGlyphIconSize}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="M1,2 L15,2 L15,13 L1,13 Z M2.5,3.5 L2.5,10 L13.5,10 L13.5,3.5 Z M8,5 L11,8 L10,9 L8.75,7.75 L8.75,10 L7.25,10 L7.25,7.75 L6,9 L5,8 Z M10,11 L11,11 L11,12 L10,12 Z M12,11 L13,11 L13,12 L12,12 Z" />
                                <PathIcon
                                    x:Name="ResumeTaskbarIcon"
                                    Width="{StaticResource SeanDockGlyphIconSize}"
                                    Height="{StaticResource SeanDockGlyphIconSize}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="M1,2 L15,2 L15,13 L1,13 Z M2.5,3.5 L2.5,10 L13.5,10 L13.5,3.5 Z M8,10 L5,7 L6,6 L7.25,7.25 L7.25,5 L8.75,5 L8.75,7.25 L10,6 L11,7 Z M10,11 L11,11 L11,12 L10,12 Z M12,11 L13,11 L13,12 L12,12 Z"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="ClockButton"
                            MinWidth="80"
                            AutomationProperties.Name="Current date and time"
                            HorizontalAlignment="Right"
                            PointerEntered="OnDockItemPointerEntered"
                            PointerExited="OnDockItemPointerExited"
                            PointerPressed="OnDockItemPointerPressed"
                            PointerReleased="OnDockItemPointerReleased"
                            Style="{StaticResource SeanDockClockButtonStyle}"
                            ToolTipService.ToolTip="Date and time"
                            VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout
                                    Placement="TopEdgeAlignedRight"
                                    MenuFlyoutPresenterStyle="{StaticResource SeanDockMenuFlyoutPresenterStyle}">
                                    <MenuFlyoutItem
                                        x:Name="ClockDetailsItem"
                                        IsEnabled="False"
                                        Text="Current date and time" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="OnOpenDateTimeSettingsClicked"
                                        Icon="Clock"
                                        Text="Date and time settings" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel>
                                <TextBlock
                                    x:Name="ClockTimeText"
                                    HorizontalAlignment="Right"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="--:--" />
                                <TextBlock
                                    x:Name="ClockDateText"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SeanCaptionTextStyle}"
                                    Text="--/--/----" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            x:Name="PeekIndicator"
            Width="120"
            Height="9"
            AutomationProperties.HelpText="Move the pointer here to expand the SeanShell dock."
            AutomationProperties.Name="SeanShell dock is collapsed"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <Border
                Width="80"
                Height="3"
                CornerRadius="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.3" Color="{ThemeResource SystemAccentColorLight1}" />
                        <GradientStop Offset="0.7" Color="{ThemeResource SystemAccentColor}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Border>
    </Grid>
</Window>
