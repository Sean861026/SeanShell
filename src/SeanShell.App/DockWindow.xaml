<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SeanShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SeanShell Dock"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="DockRoot"
        Background="Transparent"
        GotFocus="OnDockGotFocus"
        LostFocus="OnDockLostFocus"
        PointerEntered="OnDockPointerEntered"
        PointerExited="OnDockPointerExited">
        <Border
            x:Name="ExpandedDock"
            Padding="6,6,6,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid ColumnSpacing="{StaticResource SeanSpace8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Width="44"
                    Height="44"
                    AutomationProperties.Name="Open SeanShell Launcher"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    Click="OnLauncherClicked"
                    ToolTipService.ToolTip="Open Launcher">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="19"
                        Glyph="&#xE721;" />
                </Button>

                <ListView
                    x:Name="PinnedList"
                    Grid.Column="1"
                    MaxWidth="352"
                    AutomationProperties.Name="Pinned applications"
                    IsItemClickEnabled="True"
                    ItemClick="OnPinnedApplicationClicked"
                    ItemContainerStyle="{StaticResource SeanPinnedDockItemStyle}"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Width="40"
                                Height="44"
                                AutomationProperties.Name="{Binding AccessibleName}"
                                IsHitTestVisible="False"
                                ToolTipService.ToolTip="{Binding Title}">
                                <Border
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource SeanCompactCornerRadius}"
                                    VerticalAlignment="Top">
                                    <Grid Width="26" Height="26">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="17"
                                            Glyph="{Binding Glyph}"
                                            Visibility="{Binding FallbackIconVisibility}" />
                                        <Image
                                            Width="26"
                                            Height="26"
                                            Source="{Binding Icon}"
                                            Stretch="Uniform"
                                            Visibility="{Binding IconVisibility}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    x:Name="PinnedSeparator"
                    Grid.Column="2"
                    Width="1"
                    Height="32"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

                <Grid Grid.Column="3">
                    <ListView
                        x:Name="WindowList"
                        AutomationProperties.Name="Open windows on this display"
                        IsItemClickEnabled="True"
                        ItemClick="OnWindowClicked"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <StaticResource ResourceKey="SeanDockItemStyle" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Width="40"
                                    Height="44"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    ContextRequested="OnWindowContextRequested"
                                    Opacity="{Binding ContentOpacity}"
                                    ToolTipService.ToolTip="{Binding Title}">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource SeanCompactCornerRadius}"
                                        VerticalAlignment="Top">
                                        <Grid>
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="16"
                                                Glyph="&#xE8A7;"
                                                Visibility="{Binding FallbackIconVisibility}" />
                                            <Image
                                                Width="26"
                                                Height="26"
                                                Source="{Binding Icon}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconVisibility}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Width="20"
                                        Height="3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding ActiveIndicatorVisibility}" />
                                    <Border
                                        Width="7"
                                        Height="3"
                                        Background="{ThemeResource TextFillColorSecondaryBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding RunningIndicatorVisibility}" />
                                    <Border
                                        Width="5"
                                        Height="3"
                                        Background="{ThemeResource TextFillColorDisabledBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding MinimizedIndicatorVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SeanSpace8}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                        <TextBlock x:Name="EmptyStateText" Text="Loading open windows…" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="4"
                    Padding="4,0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource SeanCompactCornerRadius}"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SeanSpace4}"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="DockCountText"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="SystemAreaButton"
                        Width="40"
                        Height="40"
                        AutomationProperties.Name="Show Windows system area"
                        Click="OnSystemAreaClicked"
                        ToolTipService.ToolTip="Show the Windows taskbar for notification and system tray access"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="SystemAreaGlyph"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Glyph="&#xE7F4;" />
                    </Button>
                    <StackPanel
                        MinWidth="76"
                        AutomationProperties.Name="Current date and time"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="ClockTimeText"
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="--:--" />
                        <TextBlock
                            x:Name="ClockDateText"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SeanCaptionTextStyle}"
                            Text="--/--/----" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="PeekIndicator"
            Width="120"
            Height="8"
            AutomationProperties.HelpText="Move the pointer here to expand the SeanShell dock."
            AutomationProperties.Name="SeanShell dock is collapsed"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <Border
                Width="72"
                Height="4"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="2" />
        </Border>
    </Grid>
</Window>
