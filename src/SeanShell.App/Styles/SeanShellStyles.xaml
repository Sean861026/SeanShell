<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <LinearGradientBrush x:Key="SeanDockGlassShellBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DA193747" Offset="0" />
                <GradientStop Color="#EE0B1220" Offset="0.4" />
                <GradientStop Color="#E72C2046" Offset="0.8" />
                <GradientStop Color="#D0443541" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SeanDockGlassRegionBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#384EE4F4" Offset="0" />
                <GradientStop Color="#120B1220" Offset="0.35" />
                <GradientStop Color="#304F3288" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SeanDockGlassSystemBrush" Color="#60242138" />
            <LinearGradientBrush x:Key="SeanDockGlassStrokeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B889EEFF" Offset="0" />
                <GradientStop Color="#304AA9CC" Offset="0.4" />
                <GradientStop Color="#808F79E8" Offset="0.72" />
                <GradientStop Color="#B8E5C99B" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SeanLuxuryDetailBrush" Color="#E5C99B" />
            <LinearGradientBrush x:Key="SeanDashboardHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF133B4D" Offset="0" />
                <GradientStop Color="#FF101B32" Offset="0.48" />
                <GradientStop Color="#FF34234E" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SeanDashboardHeroTextBrush" Color="#FFF5F8FF" />
            <SolidColorBrush x:Key="SeanDashboardCardBrush" Color="#FF1D2538" />
            <SolidColorBrush x:Key="SeanDashboardCardStrokeBrush" Color="#655DADC2" />
            <LinearGradientBrush x:Key="SeanDashboardIconTileBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF19566A" Offset="0" />
                <GradientStop Color="#FF30345F" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SeanDashboardIconTileStrokeBrush" Color="#8089EEFF" />
            <SolidColorBrush x:Key="SeanDashboardIconForegroundBrush" Color="#FFF1FBFF" />
            <SolidColorBrush x:Key="SeanDashboardAccentBrush" Color="#FF89EEFF" />
            <SolidColorBrush x:Key="SeanDashboardStatusPillBrush" Color="#FF294558" />
            <SolidColorBrush x:Key="SeanDashboardStatusTextBrush" Color="#FFC6F5FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SeanDockGlassShellBrush" Color="#8CF5F5F7" />
            <SolidColorBrush x:Key="SeanDockGlassRegionBrush" Color="#45FFFFFF" />
            <SolidColorBrush x:Key="SeanDockGlassSystemBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="SeanDockGlassStrokeBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="SeanLuxuryDetailBrush" Color="#71501D" />
            <LinearGradientBrush x:Key="SeanDashboardHeroBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF214357" Offset="0" />
                <GradientStop Color="#FF2D3559" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SeanDashboardHeroTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SeanDashboardCardBrush" Color="#FFF2F6FC" />
            <SolidColorBrush x:Key="SeanDashboardCardStrokeBrush" Color="#80617393" />
            <SolidColorBrush x:Key="SeanDashboardIconTileBrush" Color="#FFD7EDF3" />
            <SolidColorBrush x:Key="SeanDashboardIconTileStrokeBrush" Color="#806A98B4" />
            <SolidColorBrush x:Key="SeanDashboardIconForegroundBrush" Color="#FF13586A" />
            <SolidColorBrush x:Key="SeanDashboardAccentBrush" Color="#FF006B82" />
            <SolidColorBrush x:Key="SeanDashboardStatusPillBrush" Color="#FFDEF4F9" />
            <SolidColorBrush x:Key="SeanDashboardStatusTextBrush" Color="#FF005E73" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SeanDockGlassShellBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDockGlassRegionBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDockGlassSystemBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDockGlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanLuxuryDetailBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDashboardHeroTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDashboardCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardIconTileBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDashboardIconTileStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardIconForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SeanDashboardStatusPillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeanDashboardStatusTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing and shape tokens follow a 4/8 px rhythm. -->
    <x:Double x:Key="SeanSpace4">4</x:Double>
    <x:Double x:Key="SeanSpace8">8</x:Double>
    <x:Double x:Key="SeanSpace12">12</x:Double>
    <x:Double x:Key="SeanSpace16">16</x:Double>
    <x:Double x:Key="SeanSpace20">20</x:Double>
    <x:Double x:Key="SeanSpace24">24</x:Double>
    <x:Double x:Key="SeanSpace32">32</x:Double>
    <x:Double x:Key="SeanDockActionSize">44</x:Double>
    <x:Double x:Key="SeanDockAppIconSize">40</x:Double>
    <x:Double x:Key="SeanDockActionIconSize">24</x:Double>
    <x:Double x:Key="SeanDockGlyphIconSize">16</x:Double>
    <x:Double x:Key="SeanDockMenuMinWidth">260</x:Double>

    <Thickness x:Key="SeanPagePadding">32</Thickness>
    <Thickness x:Key="SeanCardPadding">20</Thickness>
    <Thickness x:Key="SeanMetricCardPadding">16</Thickness>
    <Thickness x:Key="SeanCompactCardPadding">12,8</Thickness>
    <CornerRadius x:Key="SeanCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SeanCompactCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SeanPillCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SeanIconCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SeanDockShellCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="SeanDockGlassRegionCornerRadius">16</CornerRadius>

    <!-- Typography roles use the native Segoe UI Variable type system. -->
    <Style
        x:Key="SeanPageTitleTextStyle"
        BasedOn="{StaticResource TitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="SeanHeroTitleTextStyle"
        BasedOn="{StaticResource SeanPageTitleTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style
        x:Key="SeanSectionTitleTextStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SeanSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="SeanMetricLabelTextStyle"
        BasedOn="{StaticResource SeanSecondaryTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SeanMetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style
        x:Key="SeanCaptionTextStyle"
        BasedOn="{StaticResource SeanSecondaryTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Surface roles intentionally reuse system theme brushes for theme and
         high-contrast compatibility. -->
    <Style x:Key="SeanCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCardCornerRadius}" />
    </Style>

    <Style
        x:Key="SeanMetricCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanMetricCardPadding}" />
        <Setter Property="MinHeight" Value="136" />
        <Setter Property="Background" Value="{ThemeResource SeanDashboardCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDashboardCardStrokeBrush}" />
    </Style>

    <Style
        x:Key="SeanHeroCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanSpace24}" />
        <Setter Property="Background" Value="{ThemeResource SeanDashboardHeroBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDockGlassStrokeBrush}" />
    </Style>

    <Style
        x:Key="SeanFeatureCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="MinHeight" Value="156" />
        <Setter Property="Background" Value="{ThemeResource SeanDashboardCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDashboardCardStrokeBrush}" />
    </Style>

    <Style x:Key="SeanIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource SeanDashboardIconTileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDashboardIconTileStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanIconCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SeanStatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanPillCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SeanAccentStatusPillStyle"
        BasedOn="{StaticResource SeanStatusPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SeanDashboardStatusPillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDashboardIconTileStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SeanLauncherResultItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style
        x:Key="SeanCompactLauncherResultItemStyle"
        BasedOn="{StaticResource SeanLauncherResultItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="SeanDockActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="MinWidth" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Height" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="MinHeight" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style
        x:Key="SeanDockLauncherButtonStyle"
        BasedOn="{StaticResource SeanDockActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style
        x:Key="SeanDockClockButtonStyle"
        BasedOn="{StaticResource SeanDockActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style
        x:Key="SeanDockStatusButtonStyle"
        BasedOn="{StaticResource SeanDockActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Padding" Value="7,0" />
    </Style>

    <Style x:Key="SeanDockToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="MinWidth" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Height" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="MinHeight" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- macOS-inspired glass roles keep Windows theme and accessibility semantics. -->
    <Style x:Key="SeanDockGlassShellStyle" TargetType="Border">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassShellBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanDockShellCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockApplicationRegionStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassRegionBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDockGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanDockGlassRegionCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockSystemRegionStyle" TargetType="Border">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassSystemBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDockGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanDockGlassRegionCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SeanDockMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassShellBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDockGlassStrokeBrush}" />
        <Setter Property="MinWidth" Value="{StaticResource SeanDockMenuMinWidth}" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCardCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockToolTipTitleStyle" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SeanDockToolTipMetaStyle" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SeanDockToolTipActionStyle" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SeanDockFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{ThemeResource SeanDockGlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCardCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockFlyoutSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanSpace16}" />
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassShellBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCardCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockFlyoutSectionStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanSpace12}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCompactCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockFlyoutActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="{StaticResource SeanSpace12}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCompactCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="SeanDockFlyoutIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{ThemeResource SeanDockGlassRegionBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCompactCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockItemStyle" TargetType="ListViewItem">
        <Setter Property="Width" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MaxWidth" Value="48" />
        <Setter Property="Height" Value="88" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="MaxHeight" Value="88" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style
        x:Key="SeanPinnedDockItemStyle"
        BasedOn="{StaticResource SeanDockItemStyle}"
        TargetType="ListViewItem" />

    <Style
        x:Key="SeanCompactDockItemStyle"
        BasedOn="{StaticResource SeanDockItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MaxWidth" Value="44" />
        <Setter Property="Height" Value="80" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="MaxHeight" Value="80" />
        <Setter Property="Margin" Value="1,0" />
    </Style>
</ResourceDictionary>
