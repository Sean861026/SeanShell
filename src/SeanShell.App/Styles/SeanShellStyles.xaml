<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spacing and shape tokens follow a 4/8 px rhythm. -->
    <x:Double x:Key="SeanSpace4">4</x:Double>
    <x:Double x:Key="SeanSpace8">8</x:Double>
    <x:Double x:Key="SeanSpace12">12</x:Double>
    <x:Double x:Key="SeanSpace16">16</x:Double>
    <x:Double x:Key="SeanSpace20">20</x:Double>
    <x:Double x:Key="SeanSpace24">24</x:Double>
    <x:Double x:Key="SeanSpace32">32</x:Double>
    <x:Double x:Key="SeanDockActionSize">44</x:Double>
    <x:Double x:Key="SeanDockAppIconSize">26</x:Double>
    <x:Double x:Key="SeanDockActionIconSize">24</x:Double>
    <x:Double x:Key="SeanDockGlyphIconSize">16</x:Double>

    <Thickness x:Key="SeanPagePadding">32</Thickness>
    <Thickness x:Key="SeanCardPadding">20</Thickness>
    <Thickness x:Key="SeanMetricCardPadding">16</Thickness>
    <Thickness x:Key="SeanCompactCardPadding">12,8</Thickness>
    <CornerRadius x:Key="SeanCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SeanCompactCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SeanPillCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SeanIconCornerRadius">10</CornerRadius>

    <!-- Typography roles use the native Segoe UI Variable type system. -->
    <Style
        x:Key="SeanPageTitleTextStyle"
        BasedOn="{StaticResource TitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="SeanHeroTitleTextStyle"
        BasedOn="{StaticResource SeanPageTitleTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style
        x:Key="SeanSectionTitleTextStyle"
        BasedOn="{StaticResource SubtitleTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SeanSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="SeanMetricLabelTextStyle"
        BasedOn="{StaticResource SeanSecondaryTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SeanMetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style
        x:Key="SeanCaptionTextStyle"
        BasedOn="{StaticResource SeanSecondaryTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Surface roles intentionally reuse system theme brushes for theme and
         high-contrast compatibility. -->
    <Style x:Key="SeanCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCardCornerRadius}" />
    </Style>

    <Style
        x:Key="SeanMetricCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanMetricCardPadding}" />
        <Setter Property="MinHeight" Value="136" />
    </Style>

    <Style
        x:Key="SeanHeroCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SeanSpace24}" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="SeanFeatureCardStyle"
        BasedOn="{StaticResource SeanCardStyle}"
        TargetType="Border">
        <Setter Property="MinHeight" Value="156" />
    </Style>

    <Style x:Key="SeanIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanIconCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SeanStatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanPillCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SeanAccentStatusPillStyle"
        BasedOn="{StaticResource SeanStatusPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SeanLauncherResultItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style
        x:Key="SeanCompactLauncherResultItemStyle"
        BasedOn="{StaticResource SeanLauncherResultItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="SeanDockActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Height" Value="{StaticResource SeanDockActionSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCompactCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style
        x:Key="SeanDockLauncherButtonStyle"
        BasedOn="{StaticResource SeanDockActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SeanDockApplicationRegionStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanPillCornerRadius}" />
    </Style>

    <Style x:Key="SeanDockSystemRegionStyle" TargetType="Border">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanPillCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SeanDockItemStyle" TargetType="ListViewItem">
        <Setter Property="Width" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MaxWidth" Value="48" />
        <Setter Property="Height" Value="52" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="MaxHeight" Value="52" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource SeanCompactCornerRadius}" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style
        x:Key="SeanPinnedDockItemStyle"
        BasedOn="{StaticResource SeanDockItemStyle}"
        TargetType="ListViewItem" />

    <Style
        x:Key="SeanCompactDockItemStyle"
        BasedOn="{StaticResource SeanDockItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MaxWidth" Value="44" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxHeight" Value="48" />
        <Setter Property="Margin" Value="1,0" />
    </Style>
</ResourceDictionary>
