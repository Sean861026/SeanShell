<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeanShell.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SeanShell.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch">
            <Grid
                x:Name="DashboardRoot"
                MaxWidth="1600"
                Padding="{StaticResource SeanPagePadding}"
                HorizontalAlignment="Center">

                <StackPanel x:Name="DashboardSections" Spacing="{StaticResource SeanSpace32}">
                <Border x:Name="HeroCard" Style="{StaticResource SeanHeroCardStyle}">
                    <Grid
                        ColumnSpacing="{StaticResource SeanSpace24}"
                        RowSpacing="{StaticResource SeanSpace20}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="HeaderActionColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource SeanSpace16}">
                            <Border
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="22"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE8A7;" />
                            </Border>
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource SeanHeroTitleTextStyle}"
                                    Text="Developer workspace" />
                                <TextBlock
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="Your live Windows context, organized for focused development without replacing Explorer." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SeanSpace8}">
                                <Border Style="{StaticResource SeanStatusPillStyle}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="Explorer compatible" />
                                </Border>
                                <Border Style="{StaticResource SeanStatusPillStyle}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="No hooks or injection" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            x:Name="HeaderAction"
                            Grid.Row="1"
                            MinHeight="44"
                            HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Open the keyboard-first application launcher."
                            Background="Transparent"
                            BorderBrush="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Click="OnOpenLauncherClicked"
                            Content="Open Launcher"
                            Style="{StaticResource DefaultButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Spacing="{StaticResource SeanSpace12}">
                    <TextBlock
                        Style="{StaticResource SeanSectionTitleTextStyle}"
                        Text="Overview" />

                    <Grid
                        x:Name="MetricsGrid"
                        ColumnSpacing="{StaticResource SeanSpace12}"
                        RowSpacing="{StaticResource SeanSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="MetricsColumn1" Width="0" />
                            <ColumnDefinition x:Name="MetricsColumn2" Width="0" />
                            <ColumnDefinition x:Name="MetricsColumn3" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CpuCard" Style="{StaticResource SeanMetricCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE950;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanMetricLabelTextStyle}"
                                        Text="CPU" />
                                </Grid>
                                <TextBlock
                                    x:Name="CpuValue"
                                    Style="{StaticResource SeanMetricValueTextStyle}"
                                    Text="Sampling…" />
                                <ProgressBar
                                    x:Name="CpuProgress"
                                    Maximum="100"
                                    AutomationProperties.Name="CPU usage" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="MemoryCard"
                            Grid.Row="1"
                            Style="{StaticResource SeanMetricCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE950;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanMetricLabelTextStyle}"
                                        Text="Memory" />
                                </Grid>
                                <TextBlock
                                    x:Name="MemoryValue"
                                    Style="{StaticResource SeanMetricValueTextStyle}"
                                    Text="Loading…" />
                                <ProgressBar
                                    x:Name="MemoryProgress"
                                    Maximum="100"
                                    AutomationProperties.Name="Memory usage" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="WindowsCard"
                            Grid.Row="2"
                            Style="{StaticResource SeanMetricCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE8A7;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanMetricLabelTextStyle}"
                                        Text="Open windows" />
                                </Grid>
                                <TextBlock
                                    x:Name="WindowCountValue"
                                    Style="{StaticResource SeanMetricValueTextStyle}"
                                    Text="Loading…" />
                                <TextBlock Style="{StaticResource SeanSecondaryTextStyle}" Text="Shown in the dock" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="ModeCard"
                            Grid.Row="3"
                            Style="{StaticResource SeanMetricCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE713;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanMetricLabelTextStyle}"
                                        Text="Shell mode" />
                                </Grid>
                                <Border
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SeanAccentStatusPillStyle}">
                                    <TextBlock
                                        x:Name="ModeText"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Normal" />
                                </Border>
                                <TextBlock
                                    x:Name="ProviderStatus"
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Providers active" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SeanSpace12}">
                    <TextBlock
                        Style="{StaticResource SeanSectionTitleTextStyle}"
                        Text="Workspace" />

                    <Grid
                        x:Name="WorkspaceGrid"
                        ColumnSpacing="{StaticResource SeanSpace16}"
                        RowSpacing="{StaticResource SeanSpace16}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="WorkspaceColumn1" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SeanFeatureCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE8A7;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanSectionTitleTextStyle}"
                                        Text="Window dock" />
                                </Grid>
                                <TextBlock
                                    Text="Switch between normal application windows without hooks or injection."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DockStatus"
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Visible above the primary taskbar" />
                                <TextBlock
                                    x:Name="DockShortcutStatus"
                                    Style="{StaticResource SeanCaptionTextStyle}"
                                    Text="Keyboard shortcut: Ctrl + Alt + D" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="LauncherCard"
                            Grid.Row="1"
                            Style="{StaticResource SeanFeatureCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace8}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE721;" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SeanSectionTitleTextStyle}"
                                        Text="Launcher" />
                                </Grid>
                                <TextBlock
                                    Text="Search installed apps and safe system commands."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="ShortcutStatus"
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Keyboard shortcut: Alt + Space" />
                                <StackPanel Spacing="{StaticResource SeanSpace4}">
                                    <TextBlock
                                        x:Name="LauncherFirstUsablePerformance"
                                        Style="{StaticResource SeanCaptionTextStyle}"
                                        Text="First usable: Not measured · target &lt; 300 ms" />
                                    <TextBlock
                                        x:Name="LauncherSearchPerformance"
                                        Style="{StaticResource SeanCaptionTextStyle}"
                                        Text="Cached search P95: Not measured · target &lt; 50 ms" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SeanSpace12}">
                    <TextBlock
                        Style="{StaticResource SeanSectionTitleTextStyle}"
                        Text="Configuration" />

                    <Grid
                        x:Name="ConfigurationGrid"
                        ColumnSpacing="{StaticResource SeanSpace16}"
                        RowSpacing="{StaticResource SeanSpace16}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ConfigurationColumn0" Width="*" />
                            <ColumnDefinition x:Name="ConfigurationColumn1" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SeanCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace16}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE713;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SeanSpace4}">
                                        <TextBlock Style="{StaticResource SeanSectionTitleTextStyle}" Text="Shell preferences" />
                                        <TextBlock
                                            Style="{StaticResource SeanSecondaryTextStyle}"
                                            Text="Tune the Dock and keyboard-first Launcher." />
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch
                                    x:Name="DockAutoHideToggle"
                                    Header="Dock auto-hide"
                                    OffContent="Dock remains expanded on every display"
                                    OnContent="Dock collapses to a visible edge indicator"
                                    Toggled="OnDockAutoHideToggled" />

                                <ToggleSwitch
                                    x:Name="TaskbarReplacementToggle"
                                    AutomationProperties.HelpText="Hide the Windows taskbar while SeanShell is running. A separate recovery guard restores it if SeanShell exits."
                                    Header="Replace Windows taskbar"
                                    OffContent="Windows taskbar remains visible"
                                    OnContent="SeanShell Dock replaces the Windows taskbar"
                                    Toggled="OnTaskbarReplacementToggled" />

                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Compatibility mode: Explorer, notifications, system tray services, and input methods remain running. A recovery guard restores every Windows taskbar after a crash or forced exit."
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    x:Name="LauncherShortcutComboBox"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="Choose a supported global shortcut for opening the launcher."
                                    Header="Launcher shortcut"
                                    SelectionChanged="OnLauncherShortcutSelectionChanged">
                                    <ComboBoxItem Content="Alt + Space" Tag="AltSpace" />
                                    <ComboBoxItem Content="Ctrl + Alt + Space" Tag="ControlAltSpace" />
                                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="ControlShiftSpace" />
                                </ComboBox>

                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="The shortcut changes only after Windows confirms that it is available." />

                                <ComboBox
                                    x:Name="DockShortcutComboBox"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="Choose a supported global shortcut for expanding and focusing the Dock on the active display."
                                    Header="Focus Dock shortcut"
                                    SelectionChanged="OnDockShortcutSelectionChanged">
                                    <ComboBoxItem Content="Ctrl + Alt + D" Tag="ControlAltD" />
                                    <ComboBoxItem Content="Ctrl + Shift + D" Tag="ControlShiftD" />
                                </ComboBox>

                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="The shortcut expands the Dock on the active application's display and places keyboard focus on its Launcher button."
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    x:Name="ThemePreferenceComboBox"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="Choose whether SeanShell follows Windows or uses a light or dark theme."
                                    Header="Appearance"
                                    SelectionChanged="OnThemePreferenceSelectionChanged">
                                    <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>

                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="The selected appearance is applied after SeanShell restarts. High contrast always follows Windows."
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    x:Name="DisplayDensityComboBox"
                                    MinWidth="260"
                                    MaxWidth="360"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.HelpText="Choose comfortable or compact spacing for SeanShell."
                                    Header="Display density"
                                    SelectionChanged="OnDisplayDensitySelectionChanged">
                                    <ComboBoxItem Content="Comfortable" Tag="Comfortable" />
                                    <ComboBoxItem Content="Compact" Tag="Compact" />
                                </ComboBox>

                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Density changes after SeanShell restarts. Compact mode keeps interactive controls at least 44 pixels tall."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="PluginCard"
                            Grid.Row="1"
                            Style="{StaticResource SeanCardStyle}">
                            <StackPanel Spacing="{StaticResource SeanSpace12}">
                                <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SeanIconTileStyle}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE74C;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SeanSpace4}">
                                        <TextBlock Style="{StaticResource SeanSectionTitleTextStyle}" Text="Plugins" />
                                        <TextBlock
                                            x:Name="PluginStatusSummary"
                                            Style="{StaticResource SeanSecondaryTextStyle}"
                                            Text="Loading plugin status" />
                                    </StackPanel>
                                </Grid>
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Header="Manage plugins">
                                    <StackPanel Padding="0,12,0,4" Spacing="{StaticResource SeanSpace12}">
                                        <TextBlock
                                            Text="Built-in plugins use capability checks and bounded operation timeouts."
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="PluginEmptyState"
                                            Style="{StaticResource SeanSecondaryTextStyle}"
                                            Text="No built-in plugins are registered."
                                            Visibility="Collapsed" />
                                        <ItemsControl
                                            x:Name="PluginDiagnosticsList"
                                            AutomationProperties.Name="Plugin diagnostics">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:PluginDiagnosticViewModel">
                                                    <Grid Padding="4,10" ColumnSpacing="{StaticResource SeanSpace16}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="{StaticResource SeanSpace4}">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                Style="{StaticResource SeanSecondaryTextStyle}"
                                                                Text="{x:Bind Identity}" />
                                                            <TextBlock
                                                                Style="{StaticResource SeanSecondaryTextStyle}"
                                                                Text="{x:Bind Detail}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Spacing="{StaticResource SeanSpace4}">
                                                            <ToggleSwitch
                                                                MinHeight="44"
                                                                AutomationProperties.Name="{x:Bind ToggleName}"
                                                                Header="Enabled"
                                                                IsEnabled="{x:Bind CanToggle}"
                                                                IsOn="{x:Bind IsEnabled}"
                                                                Tag="{x:Bind Id}"
                                                                Toggled="OnPluginEnabledToggled" />
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind State}" />
                                                            <TextBlock
                                                                Style="{StaticResource SeanSecondaryTextStyle}"
                                                                Text="{x:Bind CapabilityText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border
                                            Height="1"
                                            Margin="0,4"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <StackPanel Spacing="{StaticResource SeanSpace8}">
                                            <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="External plugin candidates" />
                                                <Button
                                                    x:Name="RefreshExternalPluginsButton"
                                                    Grid.Column="1"
                                                    MinHeight="40"
                                                    AutomationProperties.Name="Recheck external plugin trust"
                                                    Click="OnRefreshExternalPluginsClicked"
                                                    Content="Recheck trust" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="ExternalPluginStatusSummary"
                                                Style="{StaticResource SeanSecondaryTextStyle}"
                                                Text="Scanning bounded package directory" />
                                            <TextBlock
                                                Style="{StaticResource SeanCaptionTextStyle}"
                                                Text="Diagnostic only: every recheck validates the signature and online publisher revocation status. SeanShell never loads or executes these assemblies."
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Style="{StaticResource SeanCaptionTextStyle}"
                                                Text="Broker protocol v2 can match an approved package hash to a 15-second capability grant in a separate process. Activation and command execution remain unavailable."
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="ExternalPluginEmptyState"
                                            Style="{StaticResource SeanSecondaryTextStyle}"
                                            Text="No external packages detected."
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <ItemsControl
                                            x:Name="ExternalPluginCandidateList"
                                            AutomationProperties.Name="External plugin candidate diagnostics"
                                            Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ExternalPluginCandidateViewModel">
                                                    <StackPanel Padding="4,10" Spacing="{StaticResource SeanSpace4}">
                                                        <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontWeight="SemiBold"
                                                                Text="{x:Bind State}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Style="{StaticResource SeanSecondaryTextStyle}"
                                                            Text="{x:Bind Identity}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource SeanCaptionTextStyle}"
                                                            Text="{x:Bind Detail}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource SeanCaptionTextStyle}"
                                                            Text="{x:Bind CapabilityText}"
                                                            TextWrapping="Wrap" />
                                                        <Button
                                                            MinHeight="44"
                                                            HorizontalAlignment="Left"
                                                            Click="OnExternalPluginConsentClicked"
                                                            Content="{x:Bind ActionText}"
                                                            IsEnabled="{x:Bind CanChange}"
                                                            Tag="{x:Bind Candidate}"
                                                            Visibility="{x:Bind ActionVisibility}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            x:Name="ClearExternalPluginTrustButton"
                                            MinHeight="44"
                                            HorizontalAlignment="Left"
                                            Click="OnClearExternalPluginTrustClicked"
                                            Content="Revoke all stored consent"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border x:Name="GamingModeCard" Style="{StaticResource SeanCardStyle}">
                    <StackPanel Spacing="{StaticResource SeanSpace12}">
                        <Grid ColumnSpacing="{StaticResource SeanSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SeanIconTileStyle}">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE7FC;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource SeanSpace4}">
                                <TextBlock Style="{StaticResource SeanSectionTitleTextStyle}" Text="Gaming mode" />
                                <TextBlock
                                    x:Name="GamingDetectionStatus"
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Automatic detection is off" />
                                <TextBlock
                                    x:Name="GamingDetectionPerformance"
                                    Style="{StaticResource SeanCaptionTextStyle}"
                                    Text="Detector performance: Not measured" />
                                <TextBlock
                                    x:Name="GamingSessionHistory"
                                    Style="{StaticResource SeanCaptionTextStyle}"
                                    Text="Compatibility evidence: No detected session recorded yet"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Expander Header="Configure gaming mode">
                            <StackPanel Padding="0,12,0,4" Spacing="{StaticResource SeanSpace12}">
                                <TextBlock
                                    Style="{StaticResource SeanSecondaryTextStyle}"
                                    Text="Reduce background work while a configured game is running." />
                                <ToggleSwitch
                                    x:Name="GamingModeToggle"
                                    Header="Manual gaming mode"
                                    OffContent="Automatic detection controls the effective mode"
                                    OnContent="Keep gaming mode active until manually disabled"
                                    Toggled="OnGamingModeToggled" />
                                <ToggleSwitch
                                    x:Name="AutomaticGamingModeToggle"
                                    Header="Automatic game detection"
                                    OffContent="Configured processes are not monitored"
                                    OnContent="Enter gaming mode while a configured process is running"
                                    Toggled="OnAutomaticGamingModeToggled" />
                                <TextBox
                                    x:Name="GameProcessRulesTextBox"
                                    MinHeight="88"
                                    AcceptsReturn="True"
                                    AutomationProperties.HelpText="Enter one game executable name per line. File paths and executable extensions are optional."
                                    Header="Game process names"
                                    PlaceholderText="eldenring.exe"
                                    TextWrapping="Wrap" />
                                <Button
                                    MinHeight="44"
                                    HorizontalAlignment="Left"
                                    Click="OnSaveGameRulesClicked"
                                    Content="Save game rules" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="{StaticResource SeanSpace8}">
                    <InfoBar
                        x:Name="StartupStatus"
                        IsOpen="False"
                        IsClosable="True" />
                    <InfoBar
                        x:Name="SettingsStatus"
                        IsOpen="False"
                        IsClosable="True" />
                    <InfoBar
                        x:Name="DashboardStatus"
                        IsOpen="True"
